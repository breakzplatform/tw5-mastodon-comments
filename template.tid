tags: $:/tags/ViewTemplate
title: $:/plugins/breakzplatform/mastodon-comments/template
type: text/vnd.tiddlywiki

<$list filter="[all[current]has[mastodon-post]subfilter{$:/config/breakzplatform/mastodon-comments/filter}]" variable="doNotOverrideCurrent">
	<$set name="stateTiddler" value={{{ [[$:/state/breakzplatform/mastodon-comments/]addsuffix<currentTiddler>] }}}>
		<$reveal type="nomatch" state=<<stateTiddler>> text="open">
			@@.breakzplatform-mastodon-comments-toggle
				<$button class="tc-btn-invisible" set=<<stateTiddler>> setTo="open">
					{{$:/core/images/down-arrow}}
					{{$:/plugins/breakzplatform/mastodon-comments/icon}}
					{{$:/config/breakzplatform/mastodon-comments/label-show}}
				</$button>
			@@
		</$reveal>
		<$reveal type="match" state=<<stateTiddler>> text="open">
			@@.breakzplatform-mastodon-comments-toggle
				<$button class="tc-btn-invisible" set=<<stateTiddler>> setTo="">
					{{$:/core/images/up-arrow}}
					{{$:/plugins/breakzplatform/mastodon-comments/icon}}
					{{$:/config/breakzplatform/mastodon-comments/label-hide}}
				</$button>
			@@

			<$mastodon-comments tiddler=<<currentTiddler>>/>

		</$reveal>
	</$set>
</$list>
